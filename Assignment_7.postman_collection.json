	"item": [
		{
			"name": "1. Create Books Collection with Validation",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"validator\": {\n    \"$jsonSchema\": {\n      \"bsonType\": \"object\",\n      \"required\": [\"title\"],\n      \"properties\": {\n        \"title\": {\n          \"bsonType\": \"string\",\n          \"minLength\": 1\n        }\n      }\n    }\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/collection/books",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"collection",
						"books"
					]
				},
				"description": "Create an explicit collection named 'books' with a validation rule ensuring a non-empty 'title' field."
			},
			"response": []
		},
